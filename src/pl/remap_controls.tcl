if {[llength $selected]>160} {error "Unbounded trial"}
foreach name $selected {
    set cell [get_cells -quiet $name]
    if {[llength $cell]!=1 || [get_property REF_NAME $cell] ne "FDRE"} {error "CNN target changed: $name"}
    set_property CONTROL_SET_REMAP ALL $cell
}
puts "CNN_SELECTED_ALL_CONTROL_REGISTERS [llength $selected]"
opt_design -property_opt_only -verbose
foreach item $protected {
    lassign $item name ref old
    set cell [get_cells -quiet $name]
    if {[llength $cell]!=1 || [get_property REF_NAME $cell] ne $ref} {error "Protected cell changed: $name"}
    if {$old eq ""} {reset_property DONT_TOUCH $cell} else {set_property DONT_TOUCH $old $cell}
}
